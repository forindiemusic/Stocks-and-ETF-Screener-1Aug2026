# Environment Variables for ETF Swing Trading Agent
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =============================================================================
# API Keys for Enhanced Data Sources (Optional)
# =============================================================================

# Alpha Vantage - Free tier: 5 requests/minute, 500/day
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub - Free tier: 60 requests/minute
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# Polygon.io - Free tier: 5 requests/minute
# Get key at: https://polygon.io/
POLYGON_API_KEY=

# Twelve Data - Free tier: 800 requests/day
# Get key at: https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Financial Modeling Prep - Free tier: 250 requests/day
# Get key at: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# =============================================================================
# News Sentiment API Keys (Optional - for enhanced sentiment analysis)
# =============================================================================

# NewsAPI - Free tier: 100 requests/day
# Get key at: https://newsapi.org/register
NEWSAPI_KEY=

# GNews - Free tier: 100 requests/day
# Get key at: https://gnews.io/
GNEWS_API_KEY=

# =============================================================================
# Notification Webhooks (Optional - for alerts)
# =============================================================================

# Discord webhook URL for alerts
# Create at: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Slack webhook URL for alerts
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Telegram bot token and chat ID for alerts
# Create bot: @BotFather, get chat ID: @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email settings for SMTP alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# =============================================================================
# Database / Cache Configuration (Optional)
# =============================================================================

# Redis URL for distributed caching (optional)
# REDIS_URL=redis://localhost:6379/0

# SQLite cache path (default: ./cache/swing_agent.db)
# CACHE_DB_PATH=./cache/swing_agent.db

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=text

# Log file path (optional, defaults to stdout)
# LOG_FILE=./logs/swing_agent.log

# =============================================================================
# Runtime Configuration
# =============================================================================

# Default mode: etf, stock, all, owned-etf
DEFAULT_MODE=stock

# Default config file path
CONFIG_PATH=config.yaml

# Maximum parallel workers for data fetching
MAX_WORKERS=8

# Request timeout in seconds
REQUEST_TIMEOUT=30

# =============================================================================
# Feature Flags
# =============================================================================

# Enable news sentiment analysis (requires API keys for best results)
ENABLE_NEWS_SENTIMENT=true

# Enable backtest mode
ENABLE_BACKTEST=false

# Enable dashboard (requires streamlit)
ENABLE_DASHBOARD=false